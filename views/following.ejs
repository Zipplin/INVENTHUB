<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Following - InventHub</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<div class="app-shell">

    <aside class="sidebar">

        <div class="sidebar-logo">💡 InventHub</div>

        <nav class="sidebar-nav">
            <a href="/dashboard">🏠 Dashboard</a>
            <a href="/my-inventions">💡 My Inventions</a>
            <a href="/exhibitions">🏆 Exhibitions</a>
            <a href="/marketplace">🛒 Marketplace</a>
            <a href="/bookmarks">⭐ Bookmarks</a>
            <a href="/conversations">💬 Messages</a>
            <a href="/notifications">🔔 Notifications</a>
        </nav>

        <div class="sidebar-bottom">
            <a href="/upload.html">➕ Upload Invention</a>
            <a href="/logout">🚪 Logout</a>
        </div>

    </aside>

    <main class="main">

        <h1 class="page-heading">👥 Following</h1>
        <p class="page-subheading">People <strong><%= fullname %></strong> is following</p>

        <% if (following.length === 0) { %>

            <div class="feed-card" style="padding: 40px 20px; text-align:center;">
                <p style="color:var(--text-muted); margin:0;">
                    Not following anyone yet. People you follow will appear here.
                </p>
            </div>

        <% } else { %>

            <% following.forEach(person => { %>

                <div class="feed-card feed-card-header" style="padding: 16px; align-items:center;">

                    <a href="/inventor/<%= person.id %>">
                        <% if (person.profileImage) { %>
                            <img src="/uploads/<%= person.profileImage %>" class="avatar" alt="<%= person.fullname %>">
                        <% } else { %>
                            <img src="https://ui-avatars.com/api/?name=<%= encodeURIComponent(person.fullname) %>&background=EEF2FF&color=4F46E5" class="avatar" alt="<%= person.fullname %>">
                        <% } %>
                    </a>

                    <div class="feed-card-header-info" style="flex:1;">
                        <span class="inventor-name"><%= person.fullname %></span>
                    </div>

                    <a href="/inventor/<%= person.id %>" class="btn btn-outline" style="padding: 8px 16px; font-size:13px;">
                        View Profile
                    </a>

                </div>

            <% }) %>

        <% } %>

    </main>

</div>

</body>
</html>
