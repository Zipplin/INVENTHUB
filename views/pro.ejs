<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>InventHub Pro</title>

    <style>

        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: #eef2f7;
            color: #1f2937;
            text-align: center;
        }

        .header {
            background: #1f3c88;
            color: white;
            padding: 30px;
        }

        .header h1 {
            margin: 0;
        }

        .container {
            max-width: 600px;
            margin: 50px auto;
            padding: 20px;
        }

        .pro-card {
            background: white;
            padding: 35px;
            border-radius: 18px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.1);
        }

        .price {
            font-size: 35px;
            font-weight: bold;
            color: #1f3c88;
            margin: 20px 0;
        }

        .feature {
            text-align: left;
            padding: 12px;
            font-size: 17px;
        }

        .upgrade-button {
            display: inline-block;
            margin-top: 25px;
            padding: 14px 30px;
            background: #2563eb;
            color: white;
            text-decoration: none;
            border-radius: 9px;
            font-size: 17px;
            font-weight: bold;
        }

        .upgrade-button:hover {
            background: #1d4ed8;
        }

        .back-button {
            display: inline-block;
            margin-top: 20px;
            color: #1f3c88;
            text-decoration: none;
        }
.pro-badge {
    display: inline-block;
    margin: 10px 0 20px;
    padding: 8px 16px;
    background: #16a34a;
    color: white;
    border-radius: 20px;
    font-weight: bold;
    font-size: 14px;
}
    </style>

</head>

<body>

    <div class="header">

        <h1>💎 InventHub Pro</h1>
<% if (user && user.accountType === "pro") { %>

    <div class="pro-badge">
        ✓ PRO MEMBER
    </div>

<% } %>
        <p>
            Unlock powerful tools for connecting with investors.
        </p>

    </div>


    <div class="container">

        <div class="pro-card">

            <h2>Become an InventHub Pro</h2>

            <div class="price">
                ₦1,000
            </div>

            <div class="feature">
                📹 Video calls with investors
            </div>

            <div class="feature">
                🤝 Direct investor meetings
            </div>

            <div class="feature">
                ⭐ Featured inventor visibility
            </div>

            <div class="feature">
                🚀 Premium opportunities
            </div>

            <button
    type="button"
    class="upgrade-button"
    id="upgradeButton"
>
    💎 Upgrade to Pro
</button>

            <br>

            <a
                href="/dashboard"
                class="back-button"
            >
                🏠 Back to Dashboard
            </a>

        </div>

    </div>
<script>

    document
        .getElementById("upgradeButton")
        .addEventListener("click", async () => {

            try {

                const response =
                    await fetch("/pro/upgrade", {
                        method: "POST",
                        headers: {
                            "Content-Type":
                                "application/json"
                        }
                    });

                const result =
                    await response.json();

                if (
                    result.success &&
                    result.authorization_url
                ) {

                    window.location.href =
                        result.authorization_url;

                } else {

                    alert(
                        result.message ||
                        "Payment could not be started."
                    );

                }

            } catch (error) {

                console.error(error);

                alert(
                    "Unable to start payment."
                );

            }

        });

</script>
</body>

</html>