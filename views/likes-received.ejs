<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Likes Received</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<div class="app-shell">

    <aside class="sidebar">

        <div class="sidebar-logo">💡 InventHub</div>

        <nav class="sidebar-nav">
            <a href="/dashboard">🏠 Dashboard</a>
            <a href="/my-inventions">💡 My Inventions</a>
            <a href="/exhibitions">🏆 Exhibitions</a>
            <a href="/marketplace">🛒 Marketplace</a>
            <a href="/bookmarks">⭐ Bookmarks</a>
            <a href="/conversations">💬 Messages</a>
            <a href="/notifications">🔔 Notifications</a>
        </nav>

        <div class="sidebar-bottom">
            <a href="/upload.html">➕ Upload Invention</a>
            <a href="/logout">🚪 Logout</a>
        </div>

    </aside>

    <main class="main">

        <h1 class="page-heading">❤️ Likes Received</h1>
        <p class="page-subheading">People who liked <%= fullname %>'s inventions</p>

        <% if (likes.length === 0) { %>

            <div class="feed-card" style="padding: 40px 20px; text-align:center;">
                <p style="color:var(--text-muted); margin:0;">
                    No likes yet. Once someone likes your invention, they'll show up here.
                </p>
            </div>

        <% } else { %>

            <% likes.forEach(function(like) { %>

                <div class="feed-card feed-card-header" style="padding: 16px; align-items:center;">

                    <a href="/inventor/<%= like.likerId %>">
                        <% if (like.profileImage) { %>
                            <img src="/uploads/<%= like.profileImage %>" class="avatar" alt="<%= like.fullname %>">
                        <% } else { %>
                            <img src="https://ui-avatars.com/api/?name=<%= encodeURIComponent(like.fullname) %>&background=EEF2FF&color=4F46E5" class="avatar" alt="<%= like.fullname %>">
                        <% } %>
                    </a>

                    <div class="feed-card-header-info" style="flex:1;">
                        <a href="/inventor/<%= like.likerId %>" class="inventor-name"><%= like.fullname %></a>
                        <span style="font-size:13px; color:var(--text-muted);">
                            liked "<%= like.title %>"
                        </span>
                    </div>

                    <a href="/invention/<%= like.inventionId %>" class="btn btn-outline" style="padding: 8px 16px; font-size:13px;">
                        View
                    </a>

                </div>

            <% }) %>

        <% } %>

    </main>

</div>

</body>
</html>
