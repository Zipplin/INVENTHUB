<!DOCTYPE html>
<html>
<head>
    <title>Inventor Profile</title>
    <link rel="stylesheet" href="/style.css">

    <style>
        body{
            font-family:Arial;
            background:#f4f4f4;
        }

        .container{
            width:90%;
            max-width:1000px;
            margin:auto;
        }

        .profile{
            background:white;
            padding:20px;
            margin:20px 0;
            border-radius:10px;
            box-shadow:0 2px 8px rgba(0,0,0,.1);
        }

        .card{
            background:white;
            padding:20px;
            margin:20px 0;
            border-radius:10px;
            box-shadow:0 2px 8px rgba(0,0,0,.1);
        }

        img{
            width:100%;
            max-height:350px;
            object-fit:cover;
            border-radius:10px;
        }
    </style>

</head>
<body>

<div class="container">

<div class="profile">

<h1>
    <%= user.fullname %>

    <% if (user.accountType === "pro") { %>

        <span style="
            display:inline-block;
            margin-left:8px;
            padding:5px 12px;
            background:#16a34a;
            color:white;
            border-radius:15px;
            font-size:13px;
            font-weight:bold;
            vertical-align:middle;
        ">
            ⭐ PRO INVENTOR
        </span>

    <% } %>
</h1>
<div style="margin:15px 0;font-size:18px;">

    📂 <strong><%= totalInventions %></strong> Inventions

    &nbsp;&nbsp;&nbsp;

    ❤️ <strong><%= totalLikes %></strong> Likes

    <br><br>

    👥 <strong><%= followers %></strong> Followers

    &nbsp;&nbsp;&nbsp;

    ➕ <strong><%= following %></strong> Following

</div>
<% if (currentUserId != user.id) { %>

    <form action="/follow/<%= user.id %>" method="POST" style="display:inline;">
        <button type="submit">Follow</button>
    </form>

    <a href="/messages/<%= user.id %>">
        <button>Message</button>
    </a>

<% } %>

<p><strong>Email:</strong> <%= user.email %></p>

<p><strong>Country:</strong> <%= user.country %></p>

<p><strong>City:</strong> <%= user.city %></p>

<p><strong>Account:</strong> <%= user.accountType %></p>

</div>

<h2>Published Inventions</h2>

<% if(inventions.length === 0){ %>

<h3>No inventions published yet.</h3>

<% } else { %>

<% inventions.forEach(function(invention){ %>

<div class="card">

<% if(invention.image){ %>

<img src="/uploads/<%= invention.image %>">

<% } %>

<h2><%= invention.title %></h2>

<p><strong>Category:</strong> <%= invention.category %></p>

<p><strong>Industry:</strong> <%= invention.industry %></p>

<p><strong>Country:</strong> <%= invention.country %></p>

<p><strong>Stage:</strong> <%= invention.stage %></p>

<p><strong>Looking For:</strong> <%= invention.lookingFor %></p>

<p><%= invention.description %></p>

</div>

<% }) %>

<% } %>

<br>

<a href="/dashboard">⬅ Back to Dashboard</a>

</div>

</body>
</html>