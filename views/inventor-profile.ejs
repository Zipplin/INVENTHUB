<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Inventor Profile</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<div class="app-shell">

    <aside class="sidebar">

        <div class="sidebar-logo">💡 InventHub</div>

        <nav class="sidebar-nav">
            <a href="/dashboard">🏠 Dashboard</a>
            <a href="/my-inventions">💡 My Inventions</a>
            <a href="/exhibitions">🏆 Exhibitions</a>
            <a href="/marketplace">🛒 Marketplace</a>
            <a href="/bookmarks">⭐ Bookmarks</a>
            <a href="/conversations">💬 Messages</a>
            <a href="/notifications">🔔 Notifications</a>
        </nav>

        <div class="sidebar-bottom">
            <a href="/upload.html">➕ Upload Invention</a>
            <a href="/logout">🚪 Logout</a>
        </div>

    </aside>

    <main class="main">

        <div class="feed-card" style="padding: 28px;">

            <div style="display:flex; align-items:center; gap:16px; margin-bottom:20px;">

                <% if (user.profileImage) { %>
                    <img src="/uploads/<%= user.profileImage %>" class="avatar" style="width:72px; height:72px;" alt="<%= user.fullname %>">
                <% } else { %>
                    <img src="https://ui-avatars.com/api/?name=<%= encodeURIComponent(user.fullname) %>&background=EEF2FF&color=4F46E5" class="avatar" style="width:72px; height:72px;" alt="<%= user.fullname %>">
                <% } %>

                <div>
                    <h1 class="page-heading" style="margin-bottom:4px;">
                        <%= user.fullname %>
                        <% if (user.accountType === "pro") { %>
                            <span class="pro-badge-tag" style="background:#DCFCE7; color:#16A34A;">⭐ PRO</span>
                        <% } %>
                    </h1>
                    <span style="color:var(--text-muted); font-size:14px;">
                        <%= user.city %>, <%= user.country %>
                    </span>
                </div>

            </div>

            <div class="stat-bar" style="margin: 20px 0;">

                <div class="stat-pill">
                    <span class="stat-number"><%= totalInventions %></span>
                    <span class="stat-label">Inventions</span>
                </div>

                <div class="stat-pill">
                    <span class="stat-number"><%= totalLikes %></span>
                    <span class="stat-label">Likes</span>
                </div>

                <div class="stat-pill">
                    <span class="stat-number"><%= followers %></span>
                    <span class="stat-label">Followers</span>
                </div>

                <div class="stat-pill">
                    <span class="stat-number"><%= following %></span>
                    <span class="stat-label">Following</span>
                </div>

            </div>

            <% if (currentUserId != user.id) { %>

                <div class="action-bar" style="border-top:none; padding-top:0; margin-bottom:20px;">

                    <form action="/follow/<%= user.id %>" method="POST" style="display:inline;">
                        <button type="submit" class="btn btn-primary">➕ Follow</button>
                    </form>

                    <a href="/messages/<%= user.id %>" class="btn btn-outline">💬 Message</a>

                </div>

            <% } %>

            <div class="spec-tags">
                <span class="spec-tag">EMAIL: <%= user.email %></span>
                <span class="spec-tag">ACCOUNT: <%= user.accountType %></span>
            </div>

        </div>

        <h2 class="page-heading" style="font-size:20px; margin: 28px 0 16px;">Published Inventions</h2>

        <% if (inventions.length === 0) { %>

            <div class="feed-card" style="padding: 40px 20px; text-align:center;">
                <p style="color:var(--text-muted); margin:0;">
                    No inventions published yet.
                </p>
            </div>

        <% } else { %>

            <% inventions.forEach(function(invention) { %>

                <div class="feed-card">

                    <% if (invention.image) { %>
                        <img src="/uploads/<%= invention.image %>" class="feed-card-image" alt="Invention image">
                    <% } %>

                    <div class="feed-card-body">

                        <h2 class="invention-title"><%= invention.title %></h2>

                        <div class="spec-tags">
                            <span class="spec-tag"><%= invention.category %></span>
                            <span class="spec-tag"><%= invention.industry %></span>
                            <span class="spec-tag"><%= invention.country %></span>
                            <span class="spec-tag">STAGE: <%= invention.stage %></span>
                        </div>

                        <p class="invention-description"><%= invention.description %></p>

                        <div class="meta-row">
                            <span>🤝 Looking for: <%= invention.lookingFor %></span>
                        </div>

                    </div>

                </div>

            <% }) %>

        <% } %>

    </main>

</div>

</body>
</html>
