<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Saved Inventions</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<div class="app-shell">

    <aside class="sidebar">

        <div class="sidebar-logo">💡 InventHub</div>

        <nav class="sidebar-nav">
            <a href="/dashboard">🏠 Dashboard</a>
            <a href="/my-inventions">💡 My Inventions</a>
            <a href="/exhibitions">🏆 Exhibitions</a>
            <a href="/marketplace">🛒 Marketplace</a>
            <a href="/bookmarks" class="active">⭐ Bookmarks</a>
            <a href="/conversations">💬 Messages</a>
            <a href="/notifications">🔔 Notifications</a>
        </nav>

        <div class="sidebar-bottom">
            <a href="/upload.html">➕ Upload Invention</a>
            <a href="/logout">🚪 Logout</a>
        </div>

    </aside>

    <main class="main">

        <h1 class="page-heading">⭐ Saved Inventions</h1>

        <% if (bookmarks.length === 0) { %>

            <div class="feed-card" style="padding: 40px 20px; text-align:center;">
                <p style="color:var(--text-muted); margin:0;">
                    You haven't saved any inventions yet.
                </p>
            </div>

        <% } else { %>

            <% bookmarks.forEach(item => { %>

                <div class="feed-card">

                    <div class="feed-card-body">

                        <h2 class="invention-title"><%= item.title %></h2>

                        <div class="meta-row">
                            <span>Inventor: <%= item.fullname %></span>
                        </div>

                        <p class="invention-description"><%= item.description %></p>

                        <div class="action-bar">

                            <a href="/invention/<%= item.id %>" class="btn btn-outline">
                                📄 View Details
                            </a>

                            <form action="/remove-bookmark/<%= item.id %>" method="POST" style="display:inline;">
                                <button type="submit" class="btn btn-danger">
                                    ❌ Remove Bookmark
                                </button>
                            </form>

                        </div>

                    </div>

                </div>

            <% }) %>

        <% } %>

    </main>

</div>

</body>
</html>
