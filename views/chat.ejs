<!DOCTYPE html>
<html>
<head>
    <title>Chat</title>
    <link rel="stylesheet" href="/style.css">
    <style>
        /* Extra styling just for the chat bubbles */
        .chat-window {
            background: var(--bg);
            border: 1px solid var(--border);
            border-radius: var(--radius-md);
            height: 400px;
            overflow-y: auto;
            padding: 15px;
            margin-bottom: 20px;
            display: flex;
            flex-direction: column;
            gap: 15px;
        }

        .chat-bubble {
            max-width: 75%;
            padding: 12px 16px;
            border-radius: var(--radius-lg);
            font-size: 14px;
            line-height: 1.5;
        }

        .chat-bubble.sent {
            align-self: flex-end;
            background: var(--accent);
            color: white;
            border-bottom-right-radius: 4px;
        }

        .chat-bubble.received {
            align-self: flex-start;
            background: var(--surface);
            color: var(--text);
            border: 1px solid var(--border);
            border-bottom-left-radius: 4px;
        }

        .chat-sender {
            display: block;
            font-size: 12px;
            font-weight: 700;
            margin-bottom: 4px;
        }

        .chat-bubble.sent .chat-sender {
            color: rgba(255,255,255,0.9);
        }

        .chat-bubble.received .chat-sender {
            color: var(--accent);
        }
    </style>
</head>
<body>

<div class="upload-container">

    <h1 class="upload-heading">💬 Chat with <%= person.fullname %></h1>

    <div id="messages" class="chat-window">

        <% messages.forEach(function(msg){ %>

            <% if(msg.senderId === currentUser.id){ %>
                <div class="chat-bubble sent">
                    <span class="chat-sender">You:</span>
                    <%= msg.message %>
                </div>
            <% } else { %>
                <div class="chat-bubble received">
                    <span class="chat-sender"><%= person.fullname %>:</span>
                    <%= msg.message %>
                </div>
            <% } %>

        <% }) %>

    </div>

    <form class="upload-form" action="/chat/<%= person.id %>" method="POST">

        <div class="form-group">
            <label for="message">Your Message</label>
            <textarea
                id="message"
                name="message"
                rows="4"
                required
                placeholder="Type your message..."
            ></textarea>
        </div>

        <button type="submit" class="btn btn-primary upload-btn">
            🚀 Send
        </button>

    </form>

    <br>

    <a href="/conversations" class="btn btn-outline">
        ← Back
    </a>

</div>

<script>

async function refreshChat() {

    try {

        const response = await fetch(window.location.href);

        if (!response.ok) {
            return;
        }

        const html = await response.text();
        const parser = new DOMParser();
        const newDocument = parser.parseFromString(html, "text/html");
        const currentMessages = document.getElementById("messages");
        const newMessages = newDocument.getElementById("messages");

        if (currentMessages && newMessages && currentMessages.innerHTML !== newMessages.innerHTML) {

            const wasAtBottom = currentMessages.scrollTop + currentMessages.clientHeight >= currentMessages.scrollHeight - 50;

            currentMessages.innerHTML = newMessages.innerHTML;

            // Automatically move to the newest message
            if (wasAtBottom) {
                currentMessages.scrollTop = currentMessages.scrollHeight;
            }

        }

    } catch (error) {

        console.error("❌ Could not refresh chat:", error);

    }

}

setInterval(refreshChat, 3000);

</script>

</body>
</html>