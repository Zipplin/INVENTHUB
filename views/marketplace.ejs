<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>InventHub Marketplace</title>

    <style>

        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: #eef2f7;
            color: #1f2937;
        }

        .header {
            background: #1f3c88;
            color: white;
            padding: 25px;
            text-align: center;
        }

        .header h1 {
            margin: 0;
        }

        .container {
            max-width: 1100px;
            margin: 30px auto;
            padding: 20px;
        }

        .actions {
            margin-bottom: 25px;
        }

        .button {
            display: inline-block;
            padding: 11px 18px;
            margin-right: 8px;
            background: #2563eb;
            color: white;
            text-decoration: none;
            border-radius: 8px;
        }

        .button:hover {
            background: #1d4ed8;
        }

        .products {
            display: grid;
            grid-template-columns:
                repeat(auto-fit, minmax(250px, 1fr));
            gap: 20px;
        }

        .product-card {
            background: white;
            padding: 20px;
            border-radius: 15px;
            box-shadow:
                0 5px 18px rgba(0,0,0,0.08);
        }

        .product-card img {
            width: 100%;
            height: 200px;
            object-fit: cover;
            border-radius: 10px;
        }

        .product-card h2 {
            color: #1f3c88;
        }

        .price {
            font-size: 20px;
            font-weight: bold;
            color: #16a34a;
        }

        .seller {
            color: #666;
            margin-top: 10px;
        }

        .view-button {
            display: inline-block;
            margin-top: 15px;
            padding: 10px 16px;
            background: #1f3c88;
            color: white;
            text-decoration: none;
            border-radius: 8px;
        }

    </style>

</head>

<body>

    <div class="header">

        <h1>🛒 InventHub Marketplace</h1>

        <p>
            Discover products created by InventHub innovators.
        </p>

    </div>

    <div class="container">

        <div class="actions">

            <a href="/dashboard" class="button">
                ← Dashboard
            </a>

            <% if (user && user.accountType === "pro") { %>

                <a href="/marketplace/add"
                   class="button">
                    ➕ Sell a Product
                </a>

            <% } %>

        </div>

        <div class="products">

            <% if (products.length === 0) { %>

                <p>
                    No products are currently listed.
                </p>

            <% } %>

            <% products.forEach(product => { %>

                <div class="product-card">

                    <% if (product.image) { %>

                        <img
                            src="/uploads/<%= product.image %>"
                            alt="<%= product.productName %>"
                        >

                    <% } %>

                    <h2>
                        <%= product.productName %>
                    </h2>

                    <div class="price">
                        ₦<%= Number(product.price)
                            .toLocaleString() %>
                    </div>

                    <p>
                        <%= product.description || "" %>
                    </p>

                   <div class="seller">

    <% if (product.companyLogo) { %>

        <img
            src="/uploads/<%= product.companyLogo %>"
            alt="Company Logo"
            style="
                width:45px;
                height:45px;
                object-fit:contain;
                vertical-align:middle;
                border-radius:8px;
                margin-right:8px;
            "
        >

    <% } %>

    <% if (product.companyName) { %>

        <strong>
            <%= product.companyName %>
        </strong>

    <% } else { %>

        <strong>
            <%= product.fullname %>
        </strong>

    <% } %>

    <% if (product.accountType === "pro") { %>

        <span style="
            color:#16a34a;
            font-weight:bold;
            margin-left:5px;
        ">
            ⭐ PRO
        </span>

    <% } %>

</div>

<a
    href="/marketplace/product/<%= product.id %>"
    class="view-button"
>
    View Product
</a>

<% if (user &&
       user.accountType === "pro" &&
       product.userId === user.id) { %>

    <a
        href="/marketplace/edit/<%= product.id %>"
        class="view-button"
    >
        ✏️ Edit
    </a>

    <form
        action="/marketplace/delete/<%= product.id %>"
        method="POST"
        style="display:inline;"
        onsubmit="return confirm('Are you sure you want to delete this product?');"
    >

        <button
            type="submit"
            class="view-button"
            style="
                background:#dc2626;
                border:none;
                cursor:pointer;
            "
        >
            🗑️ Delete
        </button>

    </form>

<% } %>

</div>

<% }); %>

        </div>

    </div>

</body>

</html>