<!DOCTYPE html>
<html>
<head>
    <title>Edit Invention</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>

<div class="register-container">

<h1>✏ Edit Invention</h1>

<form action="/update/<%= invention.id %>" method="POST">

<label>Title</label><br>
<input type="text" name="title" value="<%= invention.title %>" required><br><br>

<label>Category</label><br>
<input type="text" name="category" value="<%= invention.category %>" required><br><br>

<label>Industry</label><br>
<input type="text" name="industry" value="<%= invention.industry %>" required><br><br>

<label>Country</label><br>
<input type="text" name="country" value="<%= invention.country %>" required><br><br>

<label>Stage</label><br>
<input type="text" name="stage" value="<%= invention.stage %>" required><br><br>

<label>Looking For</label><br>
<input type="text" name="lookingFor" value="<%= invention.lookingFor %>" required><br><br>

<label>Description</label><br>
<textarea
name="description"
rows="8"
cols="60"
required><%= invention.description %></textarea>

<br><br>

<button type="submit">💾 Save Changes</button>

</form>

<br>

<a href="/my-inventions">⬅ Back to My Inventions</a>

</div>

</body>
</html>