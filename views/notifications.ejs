<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Notifications</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<div class="app-shell">

    <aside class="sidebar">

        <div class="sidebar-logo">💡 InventHub</div>

        <nav class="sidebar-nav">
            <a href="/dashboard">🏠 Dashboard</a>
            <a href="/my-inventions">💡 My Inventions</a>
            <a href="/exhibitions">🏆 Exhibitions</a>
            <a href="/marketplace">🛒 Marketplace</a>
            <a href="/bookmarks">⭐ Bookmarks</a>
            <a href="/conversations">💬 Messages</a>
            <a href="/notifications" class="active">🔔 Notifications</a>
        </nav>

        <div class="sidebar-bottom">
            <a href="/upload.html">➕ Upload Invention</a>
            <a href="/logout">🚪 Logout</a>
        </div>

    </aside>

    <main class="main">

        <h1 class="page-heading">🔔 Notifications</h1>

        <% if (notifications.length === 0) { %>

            <div class="feed-card" style="padding: 40px 20px; text-align:center;">
                <p style="color:var(--text-muted); margin:0;">
                    You have no notifications.
                </p>
            </div>

        <% } else { %>

            <% notifications.forEach(function(notification) { %>

                <div
                    class="feed-card"
                    style="padding:16px 18px; <%= notification.isRead ? '' : 'border-color: var(--accent); background: var(--accent-soft);' %>"
                >

                    <p style="margin:0 0 6px; font-size:14px; color:var(--text);">
                        <%= notification.message %>
                    </p>

                    <span style="font-size:12px; color:var(--text-muted);">
                        <%= notification.createdAt %>
                    </span>

                    <% if (notification.link) { %>
                        <div style="margin-top:10px;">
                            <a href="<%= notification.link %>" class="btn btn-outline" style="padding: 6px 14px; font-size:13px;">
                                View
                            </a>
                        </div>
                    <% } %>

                </div>

            <% }) %>

        <% } %>

    </main>

</div>

</body>
</html>
