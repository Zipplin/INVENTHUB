<!DOCTYPE html>
<html>

<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>InventHub Dashboard</title>
    <link rel="stylesheet" href="/css/style.css">

</head>

<body>

<div class="app-shell">

    <aside class="sidebar">

        <div class="sidebar-logo">
            💡 InventHub
        </div>

        <nav class="sidebar-nav">

            <a href="/dashboard" class="active">🏠 Dashboard</a>
            <a href="/my-inventions">💡 My Inventions</a>
            <a href="/exhibitions">🏆 Exhibitions</a>
            <a href="/marketplace">🛒 Marketplace</a>
            <a href="/bookmarks">⭐ Bookmarks</a>

            <a href="/conversations" id="messagesLink">
                💬 Messages
                <span id="messageBadge" class="nav-badge" style="display:none;">0</span>
            </a>

            <a href="/notifications">🔔 Notifications</a>

            <% if (isAdmin) { %>
                <a href="/admin/users">🛡️ Admin</a>
            <% } %>

        </nav>

        <div class="sidebar-bottom">
            <a href="/upload.html">➕ Upload Invention</a>
            <a href="/logout">🚪 Logout</a>
        </div>

    </aside>

    <main class="main">

        <h1 class="page-heading">Welcome, <%= fullname %> 👋</h1>
        <a href="/profile.html" class="avatar-link">Change profile picture</a>

        <div class="stat-bar">

            <a href="/my-inventions" class="stat-pill">
                <span class="stat-number"><%= totalInventions %></span>
                <span class="stat-label">Inventions</span>
            </a>

            <a href="/likes-received" class="stat-pill">
                <span class="stat-number"><%= totalLikes %></span>
                <span class="stat-label">Likes</span>
            </a>

            <a href="/followers" class="stat-pill">
                <span class="stat-number"><%= followers %></span>
                <span class="stat-label">Followers</span>
            </a>

            <a href="/following" class="stat-pill">
                <span class="stat-number"><%= following %></span>
                <span class="stat-label">Following</span>
            </a>

        </div>

        <% if (inventions.length == 0) { %>

            <div class="feed-card" style="padding: 40px 20px; text-align:center;">
                <p style="color:var(--text-muted); margin:0;">
                    No inventions have been published yet.
                </p>
            </div>

        <% } else { %>

            <% inventions.forEach(function(invention) { %>

                <div class="feed-card">

                    <div class="feed-card-header">

                        <a href="/inventor/<%= invention.userId %>">
                            <% if (invention.profileImage) { %>
                                <img src="/uploads/<%= invention.profileImage %>" class="avatar" alt="<%= invention.fullname %>">
                            <% } else { %>
                                <img src="https://via.placeholder.com/60" class="avatar" alt="Profile picture">
                            <% } %>
                        </a>

                        <div class="feed-card-header-info">
                            <a href="/inventor/<%= invention.userId %>" class="inventor-name">
                                <%= invention.fullname %>
                            </a>
                            <span style="font-size:12px; color:var(--text-muted);">
                                <%= invention.country %>
                            </span>
                        </div>

                    </div>

                    <% if (invention.image) { %>
                        <img src="/uploads/<%= invention.image %>" class="feed-card-image" alt="Invention image">
                    <% } %>

                    <div class="feed-card-body">

                        <h2 class="invention-title"><%= invention.title %></h2>

                        <div class="spec-tags">
                            <span class="spec-tag"><%= invention.category %></span>
                            <span class="spec-tag"><%= invention.industry %></span>
                            <span class="spec-tag">STAGE: <%= invention.stage %></span>
                        </div>

                        <p class="invention-description"><%= invention.description %></p>

                        <div class="meta-row">
                            <span>🤝 Looking for: <%= invention.lookingFor %></span>
                        </div>

                        <div class="action-bar">

                            <form action="/like/<%= invention.id %>" method="POST" style="display:inline;">
                                <button type="submit" class="icon-btn">
                                    ❤️ <%= invention.likes || 0 %>
                                </button>
                            </form>

                            <a href="/message/<%= invention.userId %>/<%= invention.id %>" class="icon-btn">
                                💬 Contact
                            </a>

                            <a href="/invention/<%= invention.id %>" class="icon-btn">
                                📄 Details
                            </a>

                            <form action="/interest/<%= invention.id %>" method="POST" style="display:inline;">
                                <button type="submit" class="icon-btn primary">
                                    💰 Interested
                                </button>
                            </form>

                            <form action="/bookmark/<%= invention.id %>" method="POST" style="display:inline;">
                                <button type="submit" class="icon-btn">
                                    ⭐ Save
                                </button>
                            </form>

                            <% if (invention.userId != userId) { %>

                                <% if (invention.isFollowing) { %>
                                    <form action="/unfollow/<%= invention.userId %>" method="POST" style="display:inline;">
                                        <button type="submit" class="icon-btn">❌ Unfollow</button>
                                    </form>
                                <% } else { %>
                                    <form action="/follow/<%= invention.userId %>" method="POST" style="display:inline;">
                                        <button type="submit" class="icon-btn">➕ Follow</button>
                                    </form>

                                    <%
                                        const callRoom = [userId, invention.userId]
                                            .sort((a, b) => a - b)
                                            .join("-");
                                    %>

                                    <a href="/video-call/<%= callRoom %>" class="icon-btn">📹 Call</a>

                                <% } %>

                            <% } %>

                        </div>

                    </div>

                    <form action="/comment/<%= invention.id %>" method="POST" class="comment-form">
                        <textarea name="comment" placeholder="Write a comment..." required></textarea>
                        <button type="submit">Post</button>
                    </form>

                    <% if (invention.comments && invention.comments.length > 0) { %>
                        <div class="comment-list">
                            <% invention.comments.forEach(comment => { %>
                                <div class="comment-item">
                                    <strong><%= comment.fullname %>:</strong> <%= comment.comment %>
                                </div>
                            <% }) %>
                        </div>
                    <% } else { %>
                        <div class="comment-empty">No comments yet.</div>
                    <% } %>

                </div>

            <% }); %>

        <% } %>

    </main>

</div>

<script>

async function checkUnreadMessages() {

    try {
        const response = await fetch("/api/unread-messages");
        if (!response.ok) return;

        const data = await response.json();
        const badge = document.getElementById("messageBadge");
        if (!badge) return;

        if (data.unread > 0) {
            badge.textContent = data.unread > 99 ? "99+" : data.unread;
            badge.style.display = "inline-block";
        } else {
            badge.style.display = "none";
        }

    } catch (error) {
        console.error("Could not check messages:", error);
    }

}

checkUnreadMessages();
setInterval(checkUnreadMessages, 5000);

</script>

</body>
</html>
